# ════════════════════════════════════════════════════════
#  Logistics AI Platform — Root .gitignore
#  Industry-standard exclusions for Python + Node + macOS
# ════════════════════════════════════════════════════════

# ─── macOS System Files ───────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride
Icon
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ─── Editor / IDE ─────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/

# ─── OS Temp Files ────────────────────────────────────
*.tmp
*.bak
*.orig
*.rej

# ─────────────────────────────────────────────────────
#  PYTHON  (backend / data_creation)
# ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc
*.pdb

# Virtual Environments
.venv/
venv/
env/
ENV/
.python-version

# Distribution / Build
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
nosetests.xml
test-results/
junit.xml

# Type checkers
.mypy_cache/
.dmypy.json
.ruff_cache/
.pyright/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Profiling
*.prof

# ─────────────────────────────────────────────────────
#  NODE / JAVASCRIPT  (frontend)
# ─────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Build output
dist/
dist-ssr/
build/
.next/
out/
.nuxt/

# Vite cache
.vite/
*.local

# Testing
coverage/
.nyc_output/
playwright-report/
test-results/
*.snap

# Cache files
.eslintcache
.stylelintcache
.cache/
.parcel-cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─────────────────────────────────────────────────────
#  ENVIRONMENT & SECRETS  (never commit these)
# ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# ─────────────────────────────────────────────────────
#  DATABASE & GENERATED DATA
# ─────────────────────────────────────────────────────
# Large CSV files generated by data_creation scripts
logistics-ai-platform/data_creation/data/
*.csv
*.sqlite
*.sqlite3
*.db

# PostgreSQL dumps
*.sql.gz
*.dump

# ─────────────────────────────────────────────────────
#  LOGS
# ─────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ─────────────────────────────────────────────────────
#  MISCELLANEOUS
# ─────────────────────────────────────────────────────
# Compressed files
*.zip
*.tar.gz
*.tgz
*.rar

# Docker (if added later)
.dockerignore
docker-compose.override.yml
